# Hashmat Uddin High School Online Admission System (HSUS) Environment Variables

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hsus_admission
POSTGRES_USER=hsus_user
POSTGRES_PASSWORD=hsus_password

# Connection string alternative (if provided, overrides individual POSTGRES_* values)
# DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=hsus_admission;Username=hsus_user;Password=hsus_password

# Backend Admission Settings
HOLD_DURATION_SECONDS=600
EXPIRATION_CHECK_INTERVAL_SECONDS=5
SEED_DEMO_DATA=true
ASPNETCORE_ENVIRONMENT=Development

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_MOCK_API=false

