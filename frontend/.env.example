# =============================================================================
# Hashmat Uddin High School Online Admission System - Environment Configuration
# =============================================================================

# Backend REST API Base URL
# - In mock mode (VITE_USE_MOCK_API=true), this value is unused.
# - In live mode (VITE_USE_MOCK_API=false), this is the base URL for the backend server
#   (e.g., http://localhost:8080 or https://admission-api.example.com).
# - Leave empty ("") if you are serving via a reverse proxy where /api or /classes are routed directly.
VITE_API_BASE_URL=http://localhost:8080

# Mode Toggle: Standalone Mock API vs Real Backend API
# - "true"  : Runs the application standalone using an in-browser simulated backend (localStorage)
#             Fully supports all business logic, seat locking, student ID validation, and admin actions.
# - "false" : Connects directly to the official assessment REST API backend:
#             POST /classes
#             GET /classes
#             GET /classes/{id}
#             POST /classes/{id}/holds
#             GET /holds/{id}
#             POST /holds/{id}/confirm
#             DELETE /holds/{id}
#             GET /me/holds (X-Student-Id header)
VITE_USE_MOCK_API=true
